FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The chamber starts full of the equilibrium products of the incoming mixture,
// at their adiabatic flame temperature; the mixing tube below z = 0 starts
// full of the fresh mixture it carries. The flame therefore exists at the dump
// plane from the first step and has only to find its own position in the
// recirculation behind the step.
//
// Products rather than hot reactants: filling a chamber this size with a hot
// premixed charge would ignite it all at once.

defaultFieldValues
(
    volScalarFieldValue T 320
    volScalarFieldValue H2 0.01730460432
    volScalarFieldValue O2 0.2288825765
    volScalarFieldValue N2 0.7538128192
    volScalarFieldValue H2O 0
);

regions
(
    boxToCell
    {
        box (-1 -1 0.002) (1 1 0.060);
        fieldValues
        (
            volScalarFieldValue T 1860
            volScalarFieldValue H2 0
            volScalarFieldValue O2 0.09155281057
            volScalarFieldValue N2 0.7538110074
            volScalarFieldValue H2O 0.154636182
        );
    }
);

