FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Not used by the serial runs these cases ship configured for -- it is here so
// that `decomposePar && mpirun -np 4 reactingFoam -parallel` needs no edit.
//
// 800 x 50 cells; four subdomains is already fine for a mesh this
// small.

numberOfSubdomains 4;

method          scotch;

// scotch needs no geometric input. If it is unavailable, hierarchical over the
// same domain is the fallback:
