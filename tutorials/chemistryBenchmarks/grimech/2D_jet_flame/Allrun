#!/bin/sh
cd "${0%/*}" || exit 1                             # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
#
#     ./Allrun                     # the variant currently selected
#     ./Allrun standard            # switch to it first, then run
#     ./Allrun kodes-temperature
#
# The kodes-* variants need a CUDA device and the libraries ../Allwmake builds;
# `standard` is the CPU reference and needs neither.
#
# The log is named after the variant, so runs of different variants do not
# overwrite each other's timings. The time directories do get overwritten --
# copy the case if you want to keep two sets of fields side by side.
#
#------------------------------------------------------------------------------

VARIANT=$1

if [ -n "$VARIANT" ]
then
    ./setChemistry "$VARIANT" || exit 1
else
    # Whatever setChemistry last put in place
    VARIANT=$(cat .chemistryVariant 2>/dev/null)
    VARIANT=${VARIANT:-standard}
fi

restore0Dir

runApplication -o blockMesh
runApplication -o setFields

# -s puts the variant in the log name, so two variants' timings survive side by
# side; -o lets the case be re-run without hand-deleting logs first.
runApplication -o -s "$VARIANT" $(getApplication)

echo
echo "Wall clock and per-step cost are in log.reactingFoam.$VARIANT."

#------------------------------------------------------------------------------
