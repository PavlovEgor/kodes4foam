FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Two things are set here, because a jet flame started from a domain full of
// still air blows out before it lights.
//
//   1. The fuel column: the tube's own stream, already filling the domain, so
//      there is a mixing layer for the flame to sit in at t = 0 rather than a
//      discontinuity that has to convect 0.06 m first.
//   2. An ignition kernel straddling that mixing layer near the nozzle --
//      equilibrium products of a lean H2/air mixture at their adiabatic
//      temperature. Hot products rather than hot reactants: they light the
//      diffusion flame by diffusing into it, without the pressure pulse a hot
//      premixed pocket would release.
//
// Cell centres of a wedge sit at y ~ r, so a box in y selects a radial band.

defaultFieldValues
(
    volScalarFieldValue T 320
    volVectorFieldValue U (0.5 0 0)
    volScalarFieldValue H2 0
    volScalarFieldValue O2 0.2329130446
    volScalarFieldValue N2 0.7670869554
    volScalarFieldValue H2O 0
);

regions
(
    boxToCell
    {
        box (-1 -1 -1) (1 0.002 1);
        fieldValues
        (
            volVectorFieldValue U (5 0 0)
            volScalarFieldValue H2 1
            volScalarFieldValue O2 0
            volScalarFieldValue N2 0
        );
    }

    boxToCell
    {
        box (0.002 -1 -1) (0.014 0.005 1);
        fieldValues
        (
            volScalarFieldValue T 1800
            volScalarFieldValue H2 0
            volScalarFieldValue O2 0.1147720726
            volScalarFieldValue N2 0.7559916611
            volScalarFieldValue H2O 0.1292362663
        );
    }
);

