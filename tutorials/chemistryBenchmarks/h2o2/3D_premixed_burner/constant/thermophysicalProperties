FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            hePsiThermo;
    mixture         reactingMixture;
    transport       sutherland;
    thermo          janaf;
    energy          sensibleEnthalpy;
    equationOfState perfectGas;
    specie          specie;
}

// The specie recovered from sum(Y) = 1, and the one pyJac eliminates from the
// state vector. The two have to be the same specie.
inertSpecie     N2;

// constant/mech is a symlink to the mechanism set's shared mech/ directory,
// one level up; all four cases of a set read the same two files.
chemistryReader foamChemistryReader;
foamChemistryFile       "<constant>/mech/thermo/reactions";
foamChemistryThermoFile "<constant>/mech/thermo/thermo.compressibleGas";

