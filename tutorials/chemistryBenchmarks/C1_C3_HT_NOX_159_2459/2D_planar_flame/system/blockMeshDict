FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Freely propagating planar flame: a channel closed laterally by a cyclic pair,
// so the front stays flat, and one cell deep.
//
// Square cells, 2.5e-05 m on a side, over a lean H2/air flame roughly 4e-4 m
// thick -- some sixteen cells across the front. The channel is 0.00125 m wide,
// a few flame thicknesses, so the front is free to wrinkle rather than being
// held flat by the cyclic pair sitting on top of it.

scale   1;

Lx      0.02;
Ly      0.00125;
Nx      800;
Ny      50;

Zmin    -1.25e-05;
Zmax    1.25e-05;

vertices
(
    (0     0     $Zmin)
    ($Lx   0     $Zmin)
    ($Lx   $Ly   $Zmin)
    (0     $Ly   $Zmin)
    (0     0     $Zmax)
    ($Lx   0     $Zmax)
    ($Lx   $Ly   $Zmax)
    (0     $Ly   $Zmax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($Nx $Ny 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 4 7 3));
    }

    outlet
    {
        type patch;
        faces ((1 2 6 5));
    }

    bottom
    {
        type cyclic;
        neighbourPatch top;
        faces ((0 1 5 4));
    }

    top
    {
        type cyclic;
        neighbourPatch bottom;
        faces ((3 7 6 2));
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

mergePatchPairs
(
);

