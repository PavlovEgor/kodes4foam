#!/bin/sh
#------------------------------------------------------------------------------
# Select the chemistry model this case runs with.
#
#     ./setChemistry standard
#     ./setChemistry kodes-temperature
#
# Copies the variant's constant/chemistryProperties and system/chemistryLibs
# into place. Both move together on purpose: chemistryProperties names the
# model and chemistryLibs loads the library that provides it, and a case with
# one without the other does not run.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

VARIANT=$1

usage()
{
    echo "usage: ${0##*/} <variant>" >&2
    echo "variants:" >&2
    for v in chemistrySetups/*/; do echo "    ${v#chemistrySetups/}" | tr -d /; done >&2
    exit 1
}

[ -n "$VARIANT" ] || usage
[ -d "chemistrySetups/$VARIANT" ] || {
    echo "${0##*/}: no such variant: $VARIANT" >&2
    usage
}

cp "chemistrySetups/$VARIANT/chemistryProperties" constant/chemistryProperties
cp "chemistrySetups/$VARIANT/chemistryLibs"       system/chemistryLibs

# Which variant that was. chemistryProperties records the model but not the
# balancer, and two variants can share a model, so Allrun cannot name its log
# from the dictionaries alone.
echo "$VARIANT" > .chemistryVariant

echo "${0##*/}: chemistry set to $VARIANT"

#------------------------------------------------------------------------------
