FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// KODES integrates the cells on the GPU, one cell per thread, in batches.
// Balancer: grouped by |dy/dt|, i.e. by how fast the cell is actually moving rather
// than by a proxy for it. Costs one extra derivatives() evaluation per cell
// per step.

chemistryType
{
    solver          ode;
    method          kodesChemistryModel;
}

chemistry       on;

initialChemicalTimeStep 1e-7;

// Read by both models. kodesChemistryModel passes absTol, relTol and maxSteps
// on to its own integrator and takes the method name from kodesSetting instead,
// so these have the same meaning either way -- which is what makes the two
// runs comparable.
odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-3;
}

kodesSetting
{
    // Opens libkodes_<mechanism>.so, built by the set's Allwmake. Its species
    // are mapped by name onto this case's species table when the case
    // starts, so a library built for another mechanism stops the run
    // there, naming the specie it lacks.
    mechanism C1_C3_HT_NOX_159_2459;

    // seulex | euler. Resolved against the KODES method table at start-up.
    integrationMethod seulex;

    // best | half. To size the run by hand give both concurrentSystems and
    // batchSize instead.
    deviceShare     best;

    // Group each batch before integrating it, so the lanes of a warp get cells
    // needing a similar number of steps.
    balanceBatches  true;

    // temperature | rhsNorm | stiffness | none
    balancerKey     rhsNorm;

    // Bytes of call stack per device thread. KODES reaches pyJac's
    // eval_jacob() through a virtual call, which is where the compiler stops
    // adding up frames and the driver falls back to its 1 KiB default -- too
    // little for a mechanism this size. The overrun surfaces as a CUDA
    // "invalid program counter" from the first cudaMemcpy after the solve
    // kernel, not from the kernel itself.
    deviceStackSize 8192;
}

