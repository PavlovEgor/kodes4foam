FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Reference run: the chemistry model that ships with OpenFOAM, on the CPU.
// Every other variant in chemistrySetups/ has to reproduce what this one
// produces, and is timed against it.

chemistryType
{
    solver          ode;
    method          standard;
}

chemistry       on;

initialChemicalTimeStep 1e-7;

// Read by both models. kodesChemistryModel passes absTol, relTol and maxSteps
// on to its own integrator and takes the method name from kodesSetting instead,
// so these have the same meaning either way -- which is what makes the two
// runs comparable.
odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-3;
}

