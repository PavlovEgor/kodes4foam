FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// One-cell-thick 5 degree wedge: the axisymmetric form OpenFOAM solves a
// round jet in.
//
//   r < 0.002 m   fuel tube, 32 cells
//   r < 0.02 m   coflow, 68 cells graded 8:1 outwards
//   x < 0.06 m   400 cells
//
// The axis carries ONE vertex per station, not one per wedge side, so the
// inner block is a prism written as a hex with its two axis vertices repeated.
// Giving the axis a vertex on each side instead would leave a zero-area quad
// there, which checkMesh reports as a face of zero area and of unbounded
// skewness. The faces that reference it -- the axis patch and the inner half
// of each inlet -- are correspondingly degenerate, e.g. (0 0 2 1); this is how
// the shipped axisymmetric tutorials write them too.

scale   1;

vertices
(
    (0            0              0               )  //  0  inlet plane, on the axis
    (0            0.001998096443 -8.723877473e-05)  //  1  inlet plane, r = 0.002, back
    (0            0.001998096443 8.723877473e-05 )  //  2  inlet plane, r = 0.002, front
    (0            0.01998096443  -0.0008723877473)  //  3  inlet plane, r = 0.02, back
    (0            0.01998096443  0.0008723877473 )  //  4  inlet plane, r = 0.02, front
    (0.06         0              0               )  //  5  outlet plane, on the axis
    (0.06         0.001998096443 -8.723877473e-05)  //  6  outlet plane, r = 0.002, back
    (0.06         0.001998096443 8.723877473e-05 )  //  7  outlet plane, r = 0.002, front
    (0.06         0.01998096443  -0.0008723877473)  //  8  outlet plane, r = 0.02, back
    (0.06         0.01998096443  0.0008723877473 )  //  9  outlet plane, r = 0.02, front
);

blocks
(
    // fuel tube; vertices 0 and 5 appear twice each, collapsing the inner edge
    hex (0 5 6 1  0 5 7 2) (400 32 1) simpleGrading (1 1 1)

    // coflow, stretched outwards so the far field is cheap
    hex (1 6 8 3  2 7 9 4) (400 68 1) simpleGrading (1 8 1)
);

edges
(
);

boundary
(
    fuelInlet
    {
        type patch;
        faces ((0 0 2 1));
    }

    coflowInlet
    {
        type patch;
        faces ((1 2 4 3));
    }

    outlet
    {
        type patch;
        faces
        (
            (5 6 7 5)
            (6 8 9 7)
        );
    }

    outerWall
    {
        // Ten jet radii out. Slip, not no-slip: this is a truncation of the
        // far field, and a boundary layer on it would be an artefact.
        type wall;
        faces ((3 4 9 8));
    }

    axis
    {
        type empty;
        faces ((0 5 5 0));
    }

    back
    {
        type wedge;
        faces
        (
            (0 1 6 5)
            (1 3 8 6)
        );
    }

    front
    {
        type wedge;
        faces
        (
            (0 5 7 2)
            (2 7 9 4)
        );
    }
);

mergePatchPairs
(
);

