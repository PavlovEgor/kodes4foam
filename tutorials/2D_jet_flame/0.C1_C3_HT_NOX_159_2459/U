FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.5 0 0);

boundaryField
{
    fuelInlet
    {
        type            fixedValue;
        value           uniform (5 0 0);
    }

    coflowInlet
    {
        type            fixedValue;
        value           uniform (0.5 0 0);
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }

    outerWall
    {
        type            slip;
    }

    axis
    {
        type            empty;
    }

    back
    {
        type            wedge;
    }

    front
    {
        type            wedge;
    }

}

