FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      radiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radiation       on;

radiationModel  opticallyThin;

// Every step: the model is a cell-wise evaluation
solverFreq      1;

opticallyThinCoeffs
{
    Tambient        293;
    species         (H2O CO2 CO CH4);
}

absorptionEmissionModel none;

scatterModel    none;

sootModel       none;

