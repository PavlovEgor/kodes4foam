FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The burner is kept at 20 C by a thermostat, and the gases leave it at that

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293;

boundaryField
{
    mainInlet
    {
        type            fixedValue;
        value           uniform 293;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 293;
        value           uniform 293;
    }
    sides
    {
        type            empty;
    }
}

