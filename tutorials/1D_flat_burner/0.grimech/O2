FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      O2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.232;

boundaryField
{
    mainInlet
    {
        type            burnerSpecieFlux;
        Y0              0.2183;
        value           uniform 0.2183;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.232;
        value           uniform 0.232;
    }
    sides
    {
        type            empty;
    }
}

