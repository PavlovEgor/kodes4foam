FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingCanteraFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;

// About six periods of the oscillations, 65 Hz in the paper's 1D runs
endTime         0.1;

deltaT          1e-07;

writeControl    adjustableRunTime;
writeInterval   0.0005;
purgeWrite      0;
writeFormat     binary;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.3;
maxDeltaT       1e-05;

// The boundary conditions of the burner and the radiation model;
// utilities/kodesCase.py adds libkodesChemistryModel.so for a kodes run
libs (libburnerBoundaryConditions.so libopticallyThinRadiation.so);

functions
{
    // max(T), max(OH) and max(Qdot), each with where it is: x of max(Qdot) is
    // the flame front (OH of this rich flame peaks downstream, in the products)
    flame
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        mode            magnitude;
        location        true;
        fields          (T OH Qdot);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
}


