FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // Not backward: with one outer corrector it lets the acoustic modes of the
    // domain grow, and the run blows up within a millisecond (1D_flat_burner:
    // 300 m/s at 0.35 ms). Euler damps them; at the time steps a flame needs
    // its first-order error is small next to the 15 ms of a period
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    div(phi,U)      Gauss limitedLinearV 1;
    div(phi,Yi_h)   Gauss limitedLinear 1;
    div(phi,K)      Gauss limitedLinear 1;

    // The correction flux of the diffusion model
    div(phiDc,Yi)   Gauss linear;

    div(mu*dev2(T(grad(U)))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

