FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Square 2-D box, fully periodic in x and y, one cell thick in z.
// Every cell sees identical conditions, so the case behaves as a homogeneous
// (0-D) constant-volume reactor replicated over all cells.

vertices
(
    (0.00 0.00 0.000)
    (0.02 0.00 0.000)
    (0.02 0.02 0.000)
    (0.00 0.02 0.000)
    (0.00 0.00 0.001)
    (0.02 0.00 0.001)
    (0.02 0.02 0.001)
    (0.00 0.02 0.001)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (128 128 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    left
    {
        type            cyclic;
        neighbourPatch  right;
        faces
        (
            (0 4 7 3)
        );
    }

    right
    {
        type            cyclic;
        neighbourPatch  left;
        faces
        (
            (1 2 6 5)
        );
    }

    bottom
    {
        type            cyclic;
        neighbourPatch  top;
        faces
        (
            (0 1 5 4)
        );
    }

    top
    {
        type            cyclic;
        neighbourPatch  bottom;
        faces
        (
            (3 7 6 2)
        );
    }

    frontAndBack
    {
        type            empty;
        faces
        (
            (4 5 6 7)
            (0 3 2 1)
        );
    }
);

mergePatchPairs
(
);


