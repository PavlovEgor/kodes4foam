FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        value           uniform 101325;
    }
    outlet
    {
        // Lets the pressure wave of the start out instead of sending it back
        type            waveTransmissive;
        field           p_rgh;
        psi             thermo:psi;
        gamma           1.4;
        fieldInf        101325;
        lInf            0.05;
        value           uniform 101325;
    }
    sides
    {
        type            empty;
    }
}

