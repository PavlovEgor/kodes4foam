FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         reactingMixture;
    transport       sutherland;     // not used: reactingCanteraLMFoam has Cantera's
    thermo          janaf;
    energy          sensibleEnthalpy;
    equationOfState perfectGas;
    specie          specie;
}

inertSpecie     N2;

chemistryReader foamChemistryReader;

foamChemistryFile "<constant>/h2o2/reactions";

foamChemistryThermoFile "<constant>/h2o2/thermo.compressibleGas";

