FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    mainInlet
    {
        type            fixedFluxPressure;
        value           uniform 1e5;
    }
    coflowInlet
    {
        type            fixedFluxPressure;
        value           uniform 1e5;
    }
    burnerWall
    {
        type            fixedFluxPressure;
        value           uniform 1e5;
    }
    outerZone
    {
        type            prghTotalPressure;
        p0              uniform 1e5;
        value           uniform 1e5;
    }
    outlet
    {
        type            prghTotalPressure;
        p0              uniform 1e5;
        value           uniform 1e5;
    }
    axis
    {
        type            empty;
    }
    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
}

