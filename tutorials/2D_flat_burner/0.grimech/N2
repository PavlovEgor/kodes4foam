FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      N2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.768;

boundaryField
{
    mainInlet
    {
        type            burnerSpecieFlux;
        Y0              0.7188;
        value           uniform 0.7188;
    }
    coflowInlet
    {
        type            burnerSpecieFlux;
        Y0              1;
        value           uniform 1;
    }
    burnerWall
    {
        type            zeroGradient;
    }
    outerZone
    {
        type            inletOutlet;
        inletValue      uniform 0.768;
        value           uniform 0.768;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.768;
        value           uniform 0.768;
    }
    axis
    {
        type            empty;
    }
    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
}

