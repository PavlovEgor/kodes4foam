FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// A guard for the log: below 280 K (the Tlow of thermo.compressibleGas) OpenFOAM
// warns in every cell and every iteration. T is not expected to go there.

limitT
{
    type            limitTemperature;
    selectionMode   all;
    min             285;
    max             2950;
}


