FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingCanteraLMFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// Three to four periods of the relaxational oscillations, 69 Hz in the paper
endTime         0.05;

deltaT          1e-07;

writeControl    adjustableRunTime;

writeInterval   0.001;

purgeWrite      0;

writeFormat     binary;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.3;

maxDeltaT       1e-06;          // resolves the pressure waves: with 1e-5 T falls below 280 K on the axis

// The boundary conditions of the burner and the radiation model;
// utilities/kodesCase.py adds libkodesChemistryModel.so for a kodes run

libs (libburnerBoundaryConditions.so libopticallyThinRadiation.so);

functions
{
    // What the photomultiplier of the experiment follows: the flame coming
    // to the burner and leaving it
    flame
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       max;
        fields          (T OH);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
    }
}

