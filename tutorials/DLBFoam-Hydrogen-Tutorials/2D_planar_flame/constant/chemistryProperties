FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistry       on;

initialChemicalTimeStep 1;

chemistryType
{
    solver          ode;
    // method          standard;
    method          kodesChemistryModel;
}

odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-3;
}

loadbalancing
{
    active          true;
    log             false;
}

refmapping
{
    active          false;
}

reactions {
}

kodesMechanism "<constant>/mechanism.cuh";

