FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/nozzle";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // The solid solves for whatever its thermo calls the energy: 'h' with
    // sensibleEnthalpy, 'e' with sensibleInternalEnergy. The upstream case
    // used the latter; constant/nozzle/thermophysicalProperties here uses the
    // former, matching how ESI writes its own conjugate tutorials. Matching
    // both keeps this file right either way.
    "(h|e)"
    {
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-8;
        relTol           0.1;
        minIter          1;
    }

    "(h|e)Final"
    {
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-8;
        relTol           0;
        minIter          1;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    equations
    {
        "(h|e)"     1;
    }
}

