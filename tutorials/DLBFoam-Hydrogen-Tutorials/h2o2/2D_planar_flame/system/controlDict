FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The stock reacting solver. kodesChemistryModel plugs in underneath it as a
// chemistryModel, so no solver of our own is needed to run the mechanism on
// the GPU -- controlDict's libs entry below is the whole of the wiring.
application     reactingFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// 100 flame times of the original tutorial. Cut this right down for a
// throughput measurement -- the per-step cost is what is being compared, and
// it is already representative after a few hundred steps.
endTime         0.0679245486;

deltaT          2.2e-06;

writeControl    runTime;

writeInterval   0.0006792455;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

// kodesChemistryModel, one library for every mechanism. The mechanism is a
// KODES library of its own, libkodes_<mechanism>.so, which the model opens
// itself by the name in kodesSetting. See ../Allwmake.
libs            ( libkodesChemistryModel.so );

