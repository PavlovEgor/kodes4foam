FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Ignition. A semi-implicit source on the enthalpy equation over the annulus
// written by system/topoSetDict, held long enough for the kernel to grow into
// a self-sustaining flame and then switched off. A non-premixed flame needs
// the mixing layer to have formed first, hence the later start than the
// premixed AHEAD case.
ignition
{
    type            scalarSemiImplicitSource;

    timeStart       0.004;
    duration        0.002;

    selectionMode   cellSet;
    cellSet         ignitionCells;

    // 'specific' makes the value a source per unit volume, so it does not
    // have to be rescaled when the mesh is refined.
    volumeMode      specific;

    sources
    {
        h           (5e9 0);   // [kg/m/s^3] explicit, implicit
    }
}

// The upstream case carried the same guard. It is not cosmetic on a mechanism
// this stiff: one runaway cell early on otherwise takes the whole run with it.
limitT
{
    type            limitTemperature;
    active          yes;
    selectionMode   all;
    min             290;
    max             3000;
}

