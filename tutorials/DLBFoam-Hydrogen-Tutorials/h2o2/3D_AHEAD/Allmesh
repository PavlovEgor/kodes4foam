#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

# system/blockMeshDict is generated and checked in, so blockMesh alone is
# enough. To change the geometry or the resolution, edit
# ../../geometry/AHEAD.json and regenerate:
#
#   ./utilities/cylindricalBurnerBlockMesh.py \
#       tutorials/DLBFoam-Hydrogen-Tutorials/geometry/AHEAD.json \
#       tutorials/DLBFoam-Hydrogen-Tutorials/<set>/3D_AHEAD/system/blockMeshDict
#
# --refine 2 there gives roughly eight times the cells.
runApplication blockMesh

# The ignition annulus in the inner shear layer, named by constant/fvOptions
runApplication topoSet

#------------------------------------------------------------------------------
