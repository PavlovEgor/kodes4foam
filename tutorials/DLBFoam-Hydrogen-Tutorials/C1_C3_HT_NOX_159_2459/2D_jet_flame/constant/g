FoamFile
{
    version     2.0;
    format      ascii;
    class       uniformDimensionedVectorField;
    location    "constant";
    object      g;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// x is the jet axis and points upwards, so gravity is along -x. Buoyancy is
// not a detail here: at Re = 330 the hydrogen jet is slow enough that the
// flame plume is partly buoyancy driven.
dimensions      [0 1 -2 0 0 0 0];
value           (-9.81 0 0);

