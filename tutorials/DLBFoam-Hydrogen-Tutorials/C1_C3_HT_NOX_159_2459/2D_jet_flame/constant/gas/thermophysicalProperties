FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/gas";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    // heRhoThermo, not the hePsiThermo of the single-region cases:
    // chtMultiRegionFoam builds its fluid regions on rhoReactionThermo.
    // kodesChemistryModel is registered for both.
    type            heRhoThermo;
    mixture         reactingMixture;
    transport       sutherland;
    thermo          janaf;
    energy          sensibleEnthalpy;
    equationOfState perfectGas;
    specie          specie;
}

inertSpecie N2;

chemistryReader foamChemistryReader;
foamChemistryFile "<constant>/gas/mech/thermo/reactions";
foamChemistryThermoFile "<constant>/gas/mech/thermo/thermo.compressibleGas";

