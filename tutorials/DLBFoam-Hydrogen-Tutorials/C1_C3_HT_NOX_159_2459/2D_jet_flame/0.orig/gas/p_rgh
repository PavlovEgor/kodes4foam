FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/gas";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// g               9.81;    // [m/s^2]
// rho_air_300K    1.16823; // [kg/m^3] (from thermo)
// gamma_air       1.39848;
// gamma_burnt     1.26;
// Note that gamma values are different for ambient air (1.39848) and burnt gases (~1.26)

dimensions      [1 -1 -2 0 0 0 0];

// Absolute, not gauge. The upstream case carried p_rgh relative to a
// constant/gas/pRef of 101000 Pa; ESI's chtMultiRegionFoam has no pRef and
// forces p_rgh = p - rho*gh at start-up, so a gauge value here would be
// overwritten by an absolute one and leave the outlet's p0 101 kPa too low --
// which drives an inflow that blows the case up on the first step.
internalField   uniform 101000;

boundaryField
{
    inletMain
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    inletAir
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    side
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    
    outlet
    {
        type            prghTotalPressure;
        p0              $internalField;
    }

    gas_to_nozzle
    {
        type            zeroGradient;
    }

    "frontAndBack.*"
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}


