FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/gas";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

// 301 K, not the 300 K of the experiment. Several species of every mechanism
// here (N2 and AR at least) have their JANAF fit starting at exactly 300 K,
// and the enthalpy inversion undershoots that bound by round-off -- about a
// milliKelvin -- on the first iteration in every cell. OpenFOAM clamps and
// carries on, so the solution is unaffected, but it prints an ungated warning
// each time, which buries the log under hundreds of megabytes. One Kelvin of
// headroom is far inside the uncertainty on "room temperature".
internalField   uniform 301;

boundaryField
{
    inletMain
    {
        type            fixedValue;
        value           $internalField;
    }

    inletAir
    {
        type            fixedValue;
        value           $internalField;
    }

    side
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
    }
    
    gas_to_nozzle
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           $internalField;
        Tnbr            T;
        kappaMethod     fluidThermo;
    }

    "frontAndBack.*"
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }

}


