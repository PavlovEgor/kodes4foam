FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Radial profiles across the chamber at a few heights above the dump plane.
//
// This is NOT the upstream sampling dictionary. That one lists the
// measurement stations of the published rig, whose geometry is not the one
// meshed here -- see ../../geometry/. It is still in the original case
// directory, ../../3D_AHEAD/system, for reference.

type            sets;
libs            (sampling);

writeControl    writeTime;

interpolationScheme cellPoint;

setFormat       raw;

fields          ( T U H2 O2 H2O OH );

sets
(
    r_z5mm
    {
        type            uniform;
        axis            y;
        nPoints         201;
        start           (0 -0.0495 0.005);
        end             (0 0.0495 0.005);
    }

    r_z10mm
    {
        type            uniform;
        axis            y;
        nPoints         201;
        start           (0 -0.0495 0.01);
        end             (0 0.0495 0.01);
    }

    r_z20mm
    {
        type            uniform;
        axis            y;
        nPoints         201;
        start           (0 -0.0495 0.02);
        end             (0 0.0495 0.02);
    }

    r_z40mm
    {
        type            uniform;
        axis            y;
        nPoints         201;
        start           (0 -0.0495 0.04);
        end             (0 0.0495 0.04);
    }

    r_z90mm
    {
        type            uniform;
        axis            y;
        nPoints         201;
        start           (0 -0.0495 0.09);
        end             (0 0.0495 0.09);
    }

    axis
    {
        type            uniform;
        axis            z;
        nPoints         301;
        start           (0 0 0.005);
        end             (0 0 0.148);
    }
);

