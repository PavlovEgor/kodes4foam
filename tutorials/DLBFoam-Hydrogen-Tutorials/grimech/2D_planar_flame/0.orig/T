FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

#include "planarMappingDict"

// Not readInletValue.H: the inlet state has to be clamped to Tmin the same way
// the internal field is, or the cold boundary alone keeps the warnings coming.
// #include "readInletValue.H";
// #include "readInternalScalarField.H"

inletValue #codeStream
{
    codeInclude
    #{
        #include "fvCFD.H"
        #include <fstream>
    #};
    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude \
        -I$(LIB_SRC)/meshTools/lnInclude
    #};
    codeLibs
    #{
        -lmeshTools \
        -lfiniteVolume
    #};
    code
    #{
        const scalar Tmin = dict.lookupOrDefault<scalar>("Tmin", 0);
        scalar value = Tmin;

        // Reading cantera data file: the first row is the cold end of the profile
        std::ifstream dataFile(dict.name() + ".dat");
        if (! dataFile.is_open()){
            Info << "WARNING: Data file " + dict.name() + ".dat is not open!" << endl;
        } else {
            dataFile >> value; // skipping x
            dataFile >> value;
        }

        value = Foam::max(value, Tmin);
        Info << "[" << dict.name() << "]: Setting " << value << " at inlet." << endl;
        os << value;
    #};
};

internalScalarField #codeStream
{
    codeInclude
    #{
        #include "fvCFD.H"
        #include <vector>
        #include "flame_cpp_funcs.H"
    #};
    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude \
        -I$(LIB_SRC)/meshTools/lnInclude \
        -I$(FOAM_CASE)/0
    #};
    codeLibs
    #{
        -lmeshTools \
        -lfiniteVolume
    #};
    code
    #{
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());
        scalarField Y(mesh.nCells(), 0.);

        // Reading cantera data file
        std::vector<float> xc, Yc;
        read_2_column_data_file(dict.name()+".dat", xc, Yc);

        // initial perturbation: dr = A*sin(f*alpha)
        const float A_perturb = dict.lookupOrDefault<float>("amplitude", xc[xc.size()-1]/500); // [m] - amplitude of the perturbation
        const float f_perturb = dict.lookupOrDefault<float>("frequency", 0); // [-] - frequency of the perturbation
        const float Lx = dict.lookupOrDefault<float>("Lx", 0); // [m] - domain length
        const float Ly = dict.lookupOrDefault<float>("Ly", 1); // [m] - domain width
        const float x_front = dict.lookupOrDefault<float>("frontCoordinate", Lx/2); // [x] - Cantera data coordinate which will be mapped to center of the domain in OpenFOAM
        const scalar Tmin = dict.lookupOrDefault<scalar>("Tmin", 0); // [K] - floor, see planarMappingDict

        // Interpolating this data on the mesh
        forAll(Y, i)
        {
            const float y = mesh.C()[i][1];
            const float dx_perturb = A_perturb*sin(f_perturb*2*Foam::constant::mathematical::pi*y/Ly); // initial perturbation
            const float x = mesh.C()[i][0] - Lx/2 + x_front - dx_perturb;

            Y[i] = Foam::max(scalar(interpolate(xc, Yc, x)), Tmin);
        }

        os << Y;
    #};
};

internalField nonuniform $internalScalarField;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $inletValue;
    }

    outlet
    {
        type            zeroGradient;
    }

    "top|bottom"
    {
        type cyclic;

    }

    empty
    {
        type            empty;
    }
}

