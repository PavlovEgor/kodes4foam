FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The injector is not resolved -- see ../../geometry/HYLON.json. The domain
// begins at its exit plane, which carries the two streams as concentric
// patches: a central hydrogen jet, and around it the annulus of swirled air.
//
//   fuel: 63.5 m/s through a 6 mm bore   -> 1.7954e-03 m3/s
//   air : 30.0 m/s through the 6-20 mm annulus -> 8.5765e-03 m3/s
//
// which is a global equivalence ratio near 0.5. The air carries solid-body
// swirl at a swirl number of 0.8, strong enough to open a central
// recirculation and anchor the flame at the injector lip.
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    fuelInlet
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 1.795420e-03;
        value           uniform (0 0 63.5);
    }

    airInlet
    {
        type            swirlFlowRateInletVelocity;
        origin          (0 0 0);
        axis            (0 0 1);
        flowRate        constant 8.576548e-03;
        rpm             constant 45837;
        value           uniform (0 0 30.0);
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    "(walls|backplane)"
    {
        type            noSlip;
    }

}

