#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

# Write one mass-fraction field per specie from 0.orig/gas/Yi.mytemplate,
# setting the internal value and each inlet from the table below. Only the
# three species that actually carry the streams are written; every other
# specie of the mechanism falls back to Ydefault, which is zero.
# Note: no -expand. Under ESI foamDictionary that flag prints the expanded
# dictionary to stdout instead of editing the file in place, so every -set
# below would be silently discarded and each specie would end up zero on every
# patch -- which the thermo then rejects as "Sum of mass fractions is zero".
# Note also that every entry is set explicitly rather than left to
# "value $internalField": foamDictionary resolves $-references as it reads the
# file and writes them back resolved, so a reference left in place would
# freeze at whatever the template said instead of following internalField.
cloneAndSetICBC()
{
    specieName=$1; internal=$2; mainJet=$3; lateral=$4; coflow=$5
    f="0/gas/$specieName"

    echo "    $specieName: internal=$internal jet=$mainJet side=$lateral air=$coflow"
    cp 0/gas/Yi.mytemplate "$f"

    foamDictionary -entry FoamFile/object                 -set "$specieName"       "$f" > /dev/null
    foamDictionary -entry internalField                   -set "uniform $internal" "$f" > /dev/null
    foamDictionary -entry boundaryField/inletMain/value    -set "uniform $mainJet" "$f" > /dev/null
    foamDictionary -entry boundaryField/inletAir/value     -set "uniform $coflow"  "$f" > /dev/null
    foamDictionary -entry boundaryField/side/value         -set "uniform $lateral" "$f" > /dev/null
    foamDictionary -entry boundaryField/outlet/inletValue  -set "uniform $lateral" "$f" > /dev/null
    foamDictionary -entry boundaryField/outlet/value       -set "uniform $lateral" "$f" > /dev/null
}

./Allclean
./Allmesh

mkdir -p 0/gas 0/nozzle
cp -r 0.orig/gas/* 0/gas/
cp -r 0.orig/nozzle/* 0/nozzle/

echo "Setting species initial and boundary conditions:"
#                   name  internal  main jet  lateral  air coflow
cloneAndSetICBC     H2    0.0       1.0       0.0      0.0
cloneAndSetICBC     O2    0.233     0.0       0.233    0.233
cloneAndSetICBC     N2    0.767     0.0       0.767    0.767
rm -f 0/gas/Yi.mytemplate

# Fills the nozzle bore with hydrogen at the jet velocity, so the jet does not
# have to be blown 30 diameters down the pipe before anything happens
runApplication setFields -region gas

runApplication $(getApplication)

