FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// The upstream case runs to 0.62 s, long enough for the jet flame to reach
// steady state. Ignition is at 1 ms, so a throughput measurement needs only a
// small fraction of that -- cut endTime right down.
endTime         0.62;

deltaT          1e-7;

writeControl    adjustableRunTime;

writeInterval   0.01;

purgeWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   9;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           4.0;

// kodesChemistryModel, one library for every mechanism. The mechanism is a
// KODES library of its own, libkodes_<mechanism>.so, which the model opens
// itself by the name in kodesSetting. See ../Allwmake.
libs            ( libkodesChemistryModel.so );

functions
{
    #includeFunc sampleFn
}

