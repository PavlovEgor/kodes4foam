// The ignition kernel: an annulus in the inner shear layer just downstream of
// the dump plane, where the swirling premixed jet first meets the
// recirculation and where this flame anchors once it is lit.
actions
(
    {
        name    ignitionCells;
        type    cellSet;
        action  new;
        source  cylinderAnnulusToCell;
        point1  (0 0 0.002);
        point2  (0 0 0.012);
        outerRadius 0.017;
        innerRadius 0.010;
    }
);

