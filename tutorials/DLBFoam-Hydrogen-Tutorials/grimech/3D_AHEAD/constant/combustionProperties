FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      combustionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Partially stirred reactor, as upstream: on an LES mesh the subgrid
// composition is not uniform, so the cell-mean reaction rate is scaled by the
// fraction of the cell where the reaction actually happens.
combustionModel  PaSR;

active           true;

PaSRCoeffs
{
    Cmix         1.0;
}

