#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/wmake/scripts/wmakeFunctions  # The wmake functions
# -----------------------------------------------------------------------------

# Remove the model and the KODES libraries from wherever a prefix put them

for libDir in "$FOAM_LIBBIN" "$FOAM_SITE_LIBBIN" "$FOAM_USER_LIBBIN"
do
    if [ -d "$libDir" ]
    then
        rm -f "$libDir"/libkodesChemistryModel* "$libDir"/libkodes_*
    fi
done

# Cleanup generated files - remove entire top-level, the CMake build of the
# KODES libraries included
removeObjectDir "$PWD"
rm -rf "Make/${WM_OPTIONS:-build}" lnInclude

# -----------------------------------------------------------------------------
