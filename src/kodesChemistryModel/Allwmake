#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
#------------------------------------------------------------------------------
#
# Build kodesChemistryModel and the KODES libraries it opens.
#
#     ./Allwmake                  the model, and libkodes_<mechanism>.so for
#                                 every mechanism in pyJacSource/
#     ./Allwmake grimech h2o2     the model, and only those mechanisms
#
# The model is plain OpenFOAM C++ and wmake builds it alone, once, for every
# mechanism: it opens libkodes_<mechanism>.so when a case starts, by the name
# in kodesSetting.
#
# The KODES libraries need CMake and nvcc. There is one per mechanism because
# pyJac writes the mechanism as CUDA source and the KODES kernels call into it
# through device-only virtuals, so the two have to share one device link. They
# are built from pyJacSource/<mechanism>/out in place, with the KODES of the
# external/KODES submodule.
#
# Both end up in $FOAM_USER_LIBBIN. NVARCH (default 120, an RTX 50xx) is the
# compute capability the libraries are built for.
#
#------------------------------------------------------------------------------

wmake libso || exit

if [ "$#" -eq 0 ]
then
    for dir in pyJacSource/*/
    do
        [ -f "$dir/out/mechanism.cuh" ] && set -- "$@" "$(basename "$dir")"
    done
fi

MECHANISMS=""

for mechanism in "$@"
do
    [ -f "pyJacSource/$mechanism/out/mechanism.cuh" ] || {
        echo "$0: no pyJac output in pyJacSource/$mechanism/out" >&2
        echo "    generate it with 'python -m pyjac -l cuda -b pyJacSource/$mechanism/out'" >&2
        exit 1
    }

    MECHANISMS="$MECHANISMS${MECHANISMS:+;}$PWD/pyJacSource/$mechanism"
done

[ -n "$MECHANISMS" ] || {
    echo "$0: no mechanism to build a KODES library for" >&2
    exit 1
}

BUILD=build/kodes

cmake -S ../../external/KODES -B "$BUILD" \
    -DKODES_MECHANISMS="$MECHANISMS" \
    -DKODES_LIBRARY_DIR="$FOAM_USER_LIBBIN" \
    -DCMAKE_CUDA_ARCHITECTURES="${NVARCH:-120}" || exit

cmake --build "$BUILD" -j "${WM_NCOMPPROCS:-4}" || exit

cmake --install "$BUILD" || exit

echo
echo "Built into \$FOAM_USER_LIBBIN: libkodesChemistryModel, which a case names in"
echo "its libs entry, and libkodes_<mechanism> for: $*"
echo "A case picks one of those with 'mechanism' in kodesSetting."

#------------------------------------------------------------------------------
